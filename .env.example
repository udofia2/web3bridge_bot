BOT_TOKEN=your_token_here
APP_ENV=development
RUNTIME_MODE=polling

WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_SECRET_TOKEN=
HOST=0.0.0.0
PORT=8000

DATABASE_URL=sqlite:///./bot.db
LOG_LEVEL=INFO
AUTO_INIT_DB=true

MAX_WARNINGS=3
FLOOD_LIMIT=5
FLOOD_WINDOW_SECS=5
MUTE_DURATION_MIN=10
BAD_WORDS=spam,scam,porn,xxx,drugs

DEFAULT_WELCOME=true
DEFAULT_ANTIFLOOD=true
DEFAULT_BADWORDS=true
DEFAULT_ANTILINKS=false
DEFAULT_WELCOME_MSG=Welcome to the group, {name}! Please read the rules.
